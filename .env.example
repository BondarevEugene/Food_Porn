# ==========================================================
# FOOD_PORN — ПРИМЕР КОНФИГУРАЦИИ
# ==========================================================
#
# 1. Скопируйте этот файл под именем `.env`.
# 2. Замените значения `replace_me` своими секретами.
# 3. Не добавляйте пробелы до или после знака `=`.
# 4. Никогда не отправляйте `.env` в чат и не публикуйте его в Git.
# 5. После случайной публикации секрет нужно отозвать и создать заново.
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#
# Linux / WSL:
#   cp .env.example .env


# ==========================================================
# TELEGRAM
# ==========================================================

# Секретный токен Telegram-бота, полученный у @BotFather.
# Формат: числовой ID бота, двоеточие и секретная строка.
# Пример ниже является заглушкой и не работает.
BOT_TOKEN=replace_me


# ==========================================================
# БАЗА ДАННЫХ POSTGRESQL / NEON
# ==========================================================

# Полная строка подключения к PostgreSQL.
# Для асинхронного SQLAlchemy используется драйвер `postgresql+asyncpg`.
#
# USER     — имя роли/пользователя Neon.
# PASSWORD — пароль этой роли.
# HOST     — адрес сервера или pooler Neon.
# DATABASE — имя базы данных, обычно `neondb`.
# ssl=require включает обязательное защищённое соединение.
#
# Если Neon выдал строку с `postgresql://`, приложение само преобразует её,
# но лучше сразу хранить правильный вариант `postgresql+asyncpg://`.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require


# ==========================================================
# OPENAI — ГЕНЕРАЦИЯ ИЗОБРАЖЕНИЙ БЛЮД
# ==========================================================

# Секретный API-ключ проекта OpenAI Platform.
# Подписка ChatGPT Plus не является балансом OpenAI API.
# Для генерации изображений у API-проекта должен быть доступный баланс.
OPENAI_API_KEY=replace_me

# Название модели, которая создаёт изображения блюд.
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Размер одного создаваемого изображения.
# Квадратный формат удобно кадрируется в карточки меню.
OPENAI_IMAGE_SIZE=1024x1024

# Качество генерации. Более высокое качество обычно требует больше времени
# и может стоить дороже. Для разработки достаточно `medium`.
OPENAI_IMAGE_QUALITY=medium


# ==========================================================
# ПРИЛОЖЕНИЕ
# ==========================================================

# Название текущего окружения: development, staging или production.
APP_ENV=development

# Уровень журналирования: DEBUG, INFO, WARNING, ERROR или CRITICAL.
LOG_LEVEL=INFO

# Корневая папка для загруженных фото, кеша и готовых PDF.
# Относительный путь считается от корня проекта.
STORAGE_ROOT=storage

# Максимальный размер одной фотографии пользователя в мегабайтах.
MAX_UPLOAD_MB=20


# ==========================================================
# ОПТИМИЗАЦИЯ ЗАПРОСОВ OPENAI
# ==========================================================

# Максимальное число одновременных запросов изображений.
# Значение 1 защищает API от всплесков и является рекомендуемым.
IMAGE_CONCURRENCY=1

# Максимальное число попыток только для временных сетевых ошибок и обычного
# rate limit. При нулевом балансе повторов нет — остановка после первого ответа.
IMAGE_RETRIES=2

# Сколько секунд не проверять OpenAI повторно после ошибки нулевого баланса.
# Кнопка «Повторить генерацию» разрешает одну ручную проверку раньше срока.
OPENAI_QUOTA_COOLDOWN_SECONDS=300

# true — повторно использовать уже созданные изображения одинаковых блюд.
# Это уменьшает стоимость, время ожидания и количество запросов.
ENABLE_IMAGE_CACHE=true


# ==========================================================
# АДМИНИСТРАТОРЫ
# ==========================================================

# Telegram ID администраторов. Сейчас поле может оставаться пустым.
# Допустимые варианты:
#   ADMIN_TELEGRAM_IDS=
#   ADMIN_TELEGRAM_IDS=123456789,987654321
#   ADMIN_TELEGRAM_IDS=[123456789,987654321]
ADMIN_TELEGRAM_IDS=
