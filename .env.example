# ==========================================================
# FOOD_PORN — ПРИМЕР КОНФИГУРАЦИИ
# ==========================================================
#
# 1. Скопируйте этот файл под именем `.env`.
# 2. Замените значения `replace_me` своими секретами.
# 3. Не добавляйте пробелы до или после знака `=`.
# 4. Никогда не отправляйте `.env` в чат и не публикуйте его в Git.
# 5. После случайной публикации секрет нужно отозвать и создать заново.
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#
# Linux / WSL:
#   cp .env.example .env


# ==========================================================
# TELEGRAM
# ==========================================================

# Секретный токен Telegram-бота, полученный у @BotFather.
# Формат: числовой ID бота, двоеточие и секретная строка.
# Пример ниже является заглушкой и не работает.
BOT_TOKEN=replace_me


# ==========================================================
# БАЗА ДАННЫХ POSTGRESQL / NEON
# ==========================================================

# Полная строка подключения к PostgreSQL.
# Для асинхронного SQLAlchemy используется драйвер `postgresql+asyncpg`.
#
# USER     — имя роли/пользователя Neon.
# PASSWORD — пароль этой роли.
# HOST     — адрес сервера или pooler Neon.
# DATABASE — имя базы данных, обычно `neondb`.
# ssl=require включает обязательное защищённое соединение.
#
# Если Neon выдал строку с `postgresql://`, приложение само преобразует её,
# но лучше сразу хранить правильный вариант `postgresql+asyncpg://`.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require


# ==========================================================
# OPENAI — ГЕНЕРАЦИЯ ИЗОБРАЖЕНИЙ БЛЮД
# ==========================================================

# Секретный API-ключ проекта OpenAI Platform.
# Подписка ChatGPT Plus не является балансом OpenAI API.
# Для генерации изображений у API-проекта должен быть доступный баланс.
OPENAI_API_KEY=replace_me

# Отдельный Admin API key организации OpenAI. Обычный OPENAI_API_KEY сюда
# не подходит. Нужен только для импорта фактических расходов в Mini CRM.
OPENAI_ADMIN_API_KEY=

# Необязательный Project ID: ограничивает импорт расходов одним проектом.
OPENAI_PROJECT_ID=

# true включает фоновую сверку фактических расходов OpenAI.
OPENAI_COST_SYNC_ENABLED=false
OPENAI_COST_SYNC_INTERVAL_MINUTES=60
OPENAI_COST_SYNC_DAYS=35

# Локальные тарифы используются как предварительная оценка до сверки с
# организационным Costs API. При изменении цен обновите их в Railway Variables.
OPENAI_TEXT_INPUT_USD_PER_MILLION=0.15
OPENAI_TEXT_OUTPUT_USD_PER_MILLION=0.60
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.075
OPENAI_IMAGE_FALLBACK_COST_USD=0.040
OPENAI_TTS_FALLBACK_COST_USD=0.020

# Название модели, которая создаёт изображения блюд.
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Размер одного создаваемого изображения.
# Квадратный формат удобно кадрируется в карточки меню.
OPENAI_IMAGE_SIZE=1024x1024

# Качество генерации. Более высокое качество обычно требует больше времени
# и может стоить дороже. Для разработки достаточно `medium`.
OPENAI_IMAGE_QUALITY=medium

# Модель для одного пакетного запроса с рецептами и списком продуктов.
RECIPE_MODEL=gpt-4o-mini

# Модель и качество для персонального подарка / карты желаний.
WALLPAPER_IMAGE_MODEL=gpt-image-2.5-sunburst
WALLPAPER_IMAGE_QUALITY=xhigh

# Модель и голос для необязательной AI-озвучки «живого коллажа».
# Без AI-озвучки ролик всё равно создаётся с локальной фоновой музыкой.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Продолжительность Premium-ролика. Разрешено от 10 до 20 секунд.
GIFT_VIDEO_SECONDS=15


# ==========================================================
# ПРИЛОЖЕНИЕ
# ==========================================================

# Название текущего окружения: development, staging или production.
APP_ENV=development

# Уровень журналирования: DEBUG, INFO, WARNING, ERROR или CRITICAL.
LOG_LEVEL=INFO

# Корневая папка для загруженных фото, кеша и готовых PDF.
# Локально достаточно `storage`. На Railway подключите Volume к /app/storage
# и задайте STORAGE_ROOT=/app/storage, иначе redeploy удалит локальные файлы.
STORAGE_ROOT=storage

# Публичный HTTPS-адрес Mini App на Railway. Без него ссылки из других
# мессенджеров сформировать невозможно.
# Пример: https://food-porn-production.up.railway.app/miniapp
MINIAPP_URL=

# Локальный порт. На Railway приложение автоматически использует PORT.
MINIAPP_PORT=8080

# false — реальные изображения OpenAI; true разрешён только для диагностики.
USE_MOCK_IMAGES=false

# Максимальный размер одной фотографии пользователя в мегабайтах.
MAX_UPLOAD_MB=20


# ==========================================================
# ОПТИМИЗАЦИЯ ЗАПРОСОВ OPENAI
# ==========================================================

# Максимальное число одновременных запросов изображений.
# Значение 1 защищает API от всплесков и является рекомендуемым.
IMAGE_CONCURRENCY=1

# Максимальное число попыток только для временных сетевых ошибок и обычного
# rate limit. При нулевом балансе повторов нет — остановка после первого ответа.
IMAGE_RETRIES=2

# Сколько секунд не проверять OpenAI повторно после ошибки нулевого баланса.
# Кнопка «Повторить генерацию» разрешает одну ручную проверку раньше срока.
OPENAI_QUOTA_COOLDOWN_SECONDS=300

# true — повторно использовать уже созданные изображения одинаковых блюд.
# Это уменьшает стоимость, время ожидания и количество запросов.
ENABLE_IMAGE_CACHE=true


# ==========================================================
# ДОПОЛНИТЕЛЬНЫЕ МЕССЕНДЖЕРЫ
# ==========================================================

# Случайный секрет не короче 32 байт для подписанных ссылок из мессенджеров.
# PowerShell: python -c "import secrets; print(secrets.token_urlsafe(48))"
CHANNEL_LINK_SECRET=
CHANNEL_LINK_TTL_HOURS=168

# Meta: один webhook /channels/meta/webhook обслуживает WhatsApp,
# Facebook Messenger и Instagram Messaging.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v24.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Viber Bot API: webhook /channels/viber/webhook.
VIBER_AUTH_TOKEN=
VIBER_BOT_NAME=Food Porn

# Slack Events API: webhook /channels/slack/events.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Discord Interactions: endpoint /channels/discord/interactions.
DISCORD_PUBLIC_KEY=


# ==========================================================
# АДМИНИСТРАТОРЫ
# ==========================================================

# Telegram ID администраторов. Сейчас поле может оставаться пустым.
# Допустимые варианты:
#   ADMIN_TELEGRAM_IDS=
#   ADMIN_TELEGRAM_IDS=123456789,987654321
#   ADMIN_TELEGRAM_IDS=[123456789,987654321]
ADMIN_TELEGRAM_IDS=

# Telegram ID с бесплатной генерацией, но без автоматического доступа к CRM.
FREE_GENERATION_TELEGRAM_IDS=

# Отдельный вход в веб-админку /admin. Пароль и секрет должны быть разными.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Подписывает cookie веб-админки. Сгенерируйте случайную строку:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=

# Ключ шифрования сохранённых CRM-интеграций (Fernet):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRM_ENCRYPTION_KEY=


# ==========================================================
# ЦЕНЫ И EMAIL-ДОСТАВКА
# ==========================================================

# Цены новых заказов. Telegram Stars и гривны учитываются раздельно.
MENU_PRICE=500.00
CURRENCY=UAH
MENU_PRICE_STARS=0
GIFT_PRICE_STARS=0
PRICE_ELECTRONIC_UAH=500
PRICE_PRINT_UAH=1200
USD_EXCHANGE_RATE=41.5

# SMTP нужен для отправки рецептов, PDF и запланированных подарков.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
PRINTSHOP_EMAIL=


# ==========================================================
# PORTMONE — ТОЛЬКО ТЕСТОВЫЙ КОНТУР ДЛЯ VIP / ADMIN
# ==========================================================

# Реквизиты магазина выдаёт Portmone индивидуально после подключения.
# Не используйте демонстрационные логины из документации и не публикуйте
# реальные значения в Git, сообщениях или скриншотах.
PORTMONE_PAYEE_ID=replace_me
PORTMONE_LOGIN=replace_me
PORTMONE_PASSWORD=replace_me

# true показывает VIP/admin диагностическую кнопку для двух цифровых продуктов.
# Она не разблокирует файлы и предназначена только для sandbox-проверки.
# Перед включением попросите Portmone активировать тестовый режим магазина.
PORTMONE_TEST_MODE=false

# Небольшая сумма диагностического счёта. В тестовом режиме карта не списывается.
PORTMONE_TEST_AMOUNT_UAH=1.00


# ==========================================================
# MONOBANK ACQUIRING — ОСНОВНАЯ ОПЛАТА КАРТОЙ
# ==========================================================

# Токен выдаётся магазину в кабинете интернет-эквайринга monobank.
# Это секрет: храните его только в .env / Railway Variables.
MONO_TOKEN=

# Необязательная HTTPS-страница, куда банк вернёт клиента после оплаты.
# Если отдельной страницы пока нет, оставьте пустым.
MONO_REDIRECT_URL=

# Необязательный публичный HTTPS webhook. До реализации проверки подписи
# безопаснее оставить пустым: бот подтвердит платёж запросом к API банка.
MONO_WEBHOOK_URL=


# ==========================================================
# WAYFORPAY — ОПЛАТА КАРТОЙ ДЛЯ ДВУХ ЦИФРОВЫХ ПРОДУКТОВ
# ==========================================================

# Корневой публичный HTTPS-адрес приложения без завершающего слеша.
# На Railway: https://foodporn-production.up.railway.app
PUBLIC_BASE_URL=https://foodporn-production.up.railway.app

# true включает официальный публичный sandbox WayForPay. Если тестовые
# реквизиты ниже пустые, приложение использует опубликованный тестовый магазин.
# false разрешается только после получения собственных реквизитов WayForPay.
WAYFORPAY_TEST_MODE=true

# Боевые Merchant Account и Secret Key выдаются в кабинете WayForPay.
# Секрет добавляйте только в Railway Variables; никогда не коммитьте его.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET_KEY=

# Домен без https:// и без пути.
WAYFORPAY_MERCHANT_DOMAIN=foodporn-production.up.railway.app

# Согласованные тестовые цены электронных продуктов.
WAYFORPAY_MENU_PRICE_UAH=5.00
WAYFORPAY_WALLPAPER_PRICE_UAH=1.00
