+import base64
+from io import BytesIO
+from types import SimpleNamespace
+
+import pytest
+from PIL import Image
+
+from app.services import wallpaper_renderer
+from app.services.vision_board import create_preview, render_board
+
+
+@pytest.mark.asyncio
+async def test_five_input_photos_reach_image_edit_and_custom_goals_reach_board(tmp_path, monkeypatch):
+    photos = []
+    for number in range(5):
+        path = tmp_path / f"photo_{number}.jpg"
+        Image.new("RGB", (400, 500), (number * 40, 20, 20)).save(path)
+        photos.append(path)
+    output = BytesIO()
+    Image.new("RGB", (64, 96), "#504030").save(output, "PNG")
+    encoded = base64.b64encode(output.getvalue()).decode()
+    received = []
+
+    class FakeImages:
+        async def edit(self, **kwargs):
+            received.extend(file.read() for file in kwargs["image"])
+            assert kwargs["size"] == "1024x1536"
+            return SimpleNamespace(data=[SimpleNamespace(b64_json=encoded, revised_prompt=None)])
+
+    class FakeClient:
+        def __init__(self, **kwargs):
+            self.images = FakeImages()
+
+        async def close(self):
+            pass
+
+    monkeypatch.setattr(wallpaper_renderer, "AsyncOpenAI", FakeClient)
+    renderer = wallpaper_renderer.WallpaperRenderer(api_key="test", output_dir=tmp_path)
+    edited = await renderer.edit_images(image_paths=photos, prompt="Compose five photos")
+    assert len(received) == 5
+    assert len(set(received)) == 5
+    goals = ["Моя семья", "Новое дело", "Путешествие", "Любимый дом", "Свобода выбора"]
+    full = render_board(edited.path, goals, tmp_path / "full.png")
+    preview = create_preview(full, tmp_path / "preview.jpg")
+    assert Image.open(full).size == (1080, 1920)
+    assert Image.open(preview).size == (540, 960)
+    assert full.stat().st_size > 10000
+    with pytest.raises(ValueError):
+        render_board(edited.path, goals[:4], tmp_path / "invalid.png")
+    await renderer.close()
