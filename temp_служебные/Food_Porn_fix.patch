+    # Existing PostgreSQL enums cannot accept the newer workflow states. ORM
+    # explicitly uses non-native SQLAlchemy enums (VARCHAR storing member names).
+    for table, column in (
+        ("customers", "language"),
+        ("menus", "status"),
+        ("menu_items", "category"),
+        ("menu_items", "generation_status"),
+        ("generated_files", "kind"),
+    ):
+        op.execute(
+            f"ALTER TABLE {table} ALTER COLUMN {column} TYPE VARCHAR(30) "
+            f"USING {column}::text"
+        )
+    op.execute("UPDATE menus SET status = 'QUEUED' WHERE status = 'GENERATING'")
+    op.execute("UPDATE menus SET status = 'IMAGES_READY' WHERE status = 'RENDERING'")
