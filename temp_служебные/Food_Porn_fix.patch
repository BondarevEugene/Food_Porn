+"""Exact typography and preview generation for the five-goal wallpaper."""
+from __future__ import annotations
+
+import os
+import re
+import uuid
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps
+
+SIZE = (1080, 1920)
+FONT_PATHS = (
+    Path("C:/Windows/Fonts/georgia.ttf"),
+    Path("C:/Windows/Fonts/arial.ttf"),
+    Path("/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf"),
+    Path("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"),
+)
+
+
+def _font(size: int) -> ImageFont.FreeTypeFont:
+    for path in FONT_PATHS:
+        if path.is_file():
+            return ImageFont.truetype(str(path), size)
+    raise RuntimeError("Install a Cyrillic TrueType font or configure a system font")
+
+
+def _wrap(draw: ImageDraw.ImageDraw, text: str, font: ImageFont.FreeTypeFont, width: int) -> str:
+    lines: list[str] = []
+    line = ""
+    for word in text.split():
+        candidate = f"{line} {word}".strip()
+        if line and draw.textlength(candidate, font=font) > width:
+            lines.append(line)
+            line = word
+        else:
+            line = candidate
+    if line:
+        lines.append(line)
+    return "\n".join(lines)
+
+
+def _draw_label(layer: Image.Image, text: str, box: tuple[int, int, int, int], large: bool = False) -> None:
+    draw = ImageDraw.Draw(layer)
+    x0, y0, x1, y1 = box
+    for size in range(55 if large else 33, 15, -1):
+        face = _font(size)
+        wrapped = _wrap(draw, text, face, x1-x0-20)
+        bbox = draw.multiline_textbbox((0, 0), wrapped, font=face, spacing=round(size*.20), align="center")
+        tw, th = bbox[2]-bbox[0], bbox[3]-bbox[1]
+        if tw <= x1-x0-20 and th <= y1-y0-15:
+            break
+    else:
+        raise ValueError(f"Goal phrase does not fit: {text!r}")
+    x = x0+(x1-x0-tw)//2
+    y = y0+(y1-y0-th)//2-bbox[1]
+    # Soft halo keeps exact Cyrillic captions legible on diverse photographs.
+    halo = Image.new("RGBA", layer.size)
+    ImageDraw.Draw(halo).multiline_text(
+        (x, y), wrapped, font=face, spacing=round(size*.20), align="center",
+        fill=(10, 7, 5, 225), stroke_width=max(5, size//7), stroke_fill=(10, 7, 5, 230),
+    )
+    layer.alpha_composite(halo.filter(ImageFilter.GaussianBlur(11)))
+    ImageDraw.Draw(layer).multiline_text(
+        (x, y), wrapped, font=face, spacing=round(size*.20), align="center",
+        fill=(255, 242, 215, 255), stroke_width=1, stroke_fill=(42, 29, 19, 180),
+    )
+
+
+def render_board(ai_image: Path, goals: list[str], destination: Path) -> Path:
+    """Place each of the five user phrases exactly once; no text comes from AI."""
+    if len(goals) != 5 or any(not isinstance(g, str) or not g.strip() or len(g) > 90 for g in goals):
+        raise ValueError("Exactly five nonempty goals of up to 90 characters are required")
+    with Image.open(ai_image) as original:
+        base = ImageOps.fit(ImageOps.exif_transpose(original).convert("RGB"), SIZE, Image.Resampling.LANCZOS)
+    # Dim the lower section for the principal phrase.
+    shade = Image.new("RGBA", SIZE)
+    draw = ImageDraw.Draw(shade)
+    for y in range(1050, SIZE[1]):
+        alpha = int(148 * (y-1050)/(SIZE[1]-1050))
+        draw.line((0, y, SIZE[0], y), fill=(10, 8, 7, alpha))
+    board = Image.alpha_composite(base.convert("RGBA"), shade)
+    text = Image.new("RGBA", SIZE)
+    boxes = [
+        (40, 235, 365, 470), (715, 235, 1040, 470),
+        (40, 890, 360, 1150), (720, 890, 1040, 1150),
+        (175, 1470, 905, 1745),
+    ]
+    for i, (goal, box) in enumerate(zip(goals, boxes, strict=True)):
+        _draw_label(text, re.sub(r"\s+", " ", goal).strip(), box, large=i == 4)
+    result = Image.alpha_composite(board, text).convert("RGB")
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = destination.with_name(f".{uuid.uuid4().hex}.tmp.png")
+    try:
+        result.save(temporary, format="PNG", optimize=True)
+        os.replace(temporary, destination)
+    finally:
+        temporary.unlink(missing_ok=True)
+    return destination
+
+
+def create_preview(board_path: Path, destination: Path) -> Path:
+    """A smaller, visibly marked preview; full-resolution art is delivered separately."""
+    with Image.open(board_path) as original:
+        image = original.convert("RGB").resize((540, 960), Image.Resampling.LANCZOS)
+    overlay = Image.new("RGBA", image.size)
+    draw = ImageDraw.Draw(overlay)
+    face = _font(29)
+    for y in (160, 420, 680, 900):
+        draw.text((95, y), "FOOD_PORN  •  ПРЕВЬЮ", font=face,
+                  fill=(255, 255, 255, 150), stroke_width=2, stroke_fill=(0, 0, 0, 110))
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    Image.alpha_composite(image.convert("RGBA"), overlay).convert("RGB").save(destination, "JPEG", quality=82)
+    return destination
